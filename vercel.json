{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "public",
  "functions": {
    "api/rooms.js": {
      "maxDuration": 20
    },
    "api/account.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/play",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
